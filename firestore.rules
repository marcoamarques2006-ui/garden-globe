rules_version = '2';

// Cole no Console do Firebase → Firestore Database → Regras.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validOwner() { return request.resource.data.owner in ['Marco', 'Estela']; }

    match /points/{pointId} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn() && validOwner();

      match /media/{mediaId} {
        allow read, write: if signedIn();
      }
    }

    match /meta/{docId} {
      allow read, write: if signedIn();
    }
  }
}
